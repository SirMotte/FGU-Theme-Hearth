		<sheetdata>
			<stringcontrol name="dierollmult_label">
				<anchored>
					<top offset="52" anchor="bottom" parent="properties" relation="current" />
				</anchored>
			</stringcontrol>
			<stringcontrol name="die_label">
				<anchored>
					<top offset="52" anchor="bottom" parent="properties" relation="current" />
					<left offset="32" />
				</anchored>
			</stringcontrol>
			<stringcontrol name="Casterlvl_label">
				<anchored>
					<top offset="52" anchor="bottom" parent="properties" relation="current" />
				</anchored>
			</stringcontrol>
			<stringcontrol name="mod_label">
				<anchored>
					<top offset="52" anchor="bottom" parent="properties" relation="current" />
				</anchored>
			</stringcontrol>
			<stringfield name="spells_die">
				<frame>
					<name>ct_subgroupbox</name>
				</frame>
				<anchored>
					<top offset="71" anchor="bottom" parent="properties" relation="current" />
				</anchored>
				<center />
				<gmeditonly />
			</stringfield>
			<number name="numbertoroll">
				<frame>
					<name>ct_subgroupbox</name>
				</frame>
				<anchored>
					<top offset="71" anchor="bottom" parent="properties" relation="current" />
				</anchored>
				<backcolor merge="delete" />
			</number>
			<button_stringcycler name="level_field">
				<anchored>
					<top offset="71" anchor="bottom" parent="properties" relation="current" />
				</anchored>
			</button_stringcycler>
			<number name="modifier">
				<anchored>
					<top offset="71" anchor="bottom" parent="properties" relation="current" />
				</anchored>
			</number>
		</sheetdata>
	</windowclass>

	<!-- Source: ct/ct_host.xml & ct/ct_template.xml -->
	<windowclass name="combattracker_host" merge="join">
		<margins control="0,0,5,4" />
		<sizelimits>
			<minimum width="520" />
			<dynamic />
		</sizelimits>
	</windowclass>

	<template name="number_clientct_hptemp" merge="join">
		<number_ct_static>
			<color>#69B7FF</color>
		</number_ct_static>
	</template>

	<!-- OSE2 Character Sheet: Add right side buffer and clean header spacing -->
	<template name="anchor_content_charsheet_tabbed_top" merge="join">
		<genericcontrol>
			<anchored>
				<top offset="42" />
			</anchored>
		</genericcontrol>
	</template>
	<windowclass name="charsheet" merge="join">
		<placement>
			<size width="550" height="625" />
		</placement>
		<sizelimits>
			<minimum width="550" height="625" />
			<dynamic />
		</sizelimits>
	</windowclass>
